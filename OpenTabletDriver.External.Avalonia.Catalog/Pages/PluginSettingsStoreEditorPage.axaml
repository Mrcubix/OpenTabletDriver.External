<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:OpenTabletDriver.External.Avalonia.Catalog.ViewModels"
             xmlns:ext-controls="clr-namespace:OpenTabletDriver.External.Avalonia.Controls;assembly=OpenTabletDriver.External.Avalonia"
             mc:Ignorable="d" d:DesignWidth="660" d:DesignHeight="600"
             x:DataType="vm:MainViewModel"
             x:Class="OpenTabletDriver.External.Avalonia.Catalog.Pages.PluginSettingsStoreEditorPage">

  <Design.DataContext>
    <vm:MainViewModel />
  </Design.DataContext>

  <ScrollViewer VerticalScrollBarVisibility="Auto" Grid.IsSharedSizeScope="True">
    <Grid RowDefinitions="Auto">
      <ext-controls:PluginSettingStoreEditor DataContext="{Binding ExamplePluginSettingsStoreEditor}" Grid.Row="0" />
    </Grid>
  </ScrollViewer>
</UserControl>
