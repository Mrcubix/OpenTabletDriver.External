<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:tc="clr-namespace:OpenTabletDriver.External.Avalonia.TemplatedControls"
                    mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="100">

  <Design.PreviewWith>
    <StackPanel Grid.IsSharedSizeScope="True">
      <tc:RangedInput Label="Some Value" Value="123" Minimum="0" Maximum="255" Unit="%" />
    </StackPanel>
  </Design.PreviewWith>

  <ControlTheme x:Key="{x:Type tc:RangedInput}" TargetType="tc:RangedInput">
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_Background" Classes="Container">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" SharedSizeGroup="INPUT_labelcol" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="6*" />
              <ColumnDefinition Width="64" />
              <ColumnDefinition Width="Auto" SharedSizeGroup="INPUT_unitcol" />
            </Grid.ColumnDefinitions>

            <TextBlock Name="PART_Label" Text="{TemplateBinding Label}" Classes="Label" Grid.Column="0"/>
            <Slider Name="PART_Slider" Grid.Column="2" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" 
                    Value="{TemplateBinding Value, Mode=TwoWay}" IsEnabled="{TemplateBinding IsReadOnly}"/>
            <TextBox Name="PART_Input" Classes="HorizontalGridMarginTight" Text="{TemplateBinding Text}" IsReadOnly="{TemplateBinding IsReadOnly}" Grid.Column="3" />
            <TextBlock Name="PART_Unit" Text="{TemplateBinding Unit}" Grid.Column="4" HorizontalAlignment="Left"
                       IsVisible="{TemplateBinding Unit, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

</ResourceDictionary>