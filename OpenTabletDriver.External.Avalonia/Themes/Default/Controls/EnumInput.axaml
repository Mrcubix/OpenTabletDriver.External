<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:tc="clr-namespace:OpenTabletDriver.External.Avalonia.TemplatedControls"
                    mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="100">

  <ControlTheme x:Key="{x:Type tc:EnumInput}" TargetType="tc:EnumInput">
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_Background" Classes="Container">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" SharedSizeGroup="INPUT_labelcol" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="3*" MinWidth="120" SharedSizeGroup="INPUT_validcol" />
              <ColumnDefinition Width="Auto" SharedSizeGroup="INPUT_unitcol"/>
            </Grid.ColumnDefinitions>
            
            <TextBlock Text="{TemplateBinding Label}" Classes="Label" Grid.Column="0" />
            <ComboBox Name="PART_Input" ItemsSource="{TemplateBinding ItemsSource}" SelectedItem="{TemplateBinding SelectedItem}"
                      SelectedIndex="{TemplateBinding SelectedIndex}" IsEnabled="{TemplateBinding IsReadOnly, Converter={x:Static BoolConverters.Not}}" 
                      Grid.Column="2" Margin="10,0" />
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

</ResourceDictionary>