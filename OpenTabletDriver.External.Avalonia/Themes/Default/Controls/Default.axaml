<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="BooleanInput.axaml"/>
        <ResourceInclude Source="DoubleInput.axaml"/>
        <ResourceInclude Source="EnumInput.axaml"/>
        <ResourceInclude Source="RangedInput.axaml"/>
        <ResourceInclude Source="StringInput.axaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Styles.Resources>

</Styles>
