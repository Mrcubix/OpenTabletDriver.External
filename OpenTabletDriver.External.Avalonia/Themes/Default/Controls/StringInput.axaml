<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:tc="clr-namespace:OpenTabletDriver.External.Avalonia.TemplatedControls"
                    mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="100">
               
  <ControlTheme x:Key="{x:Type tc:StringInput}" TargetType="tc:StringInput">
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_Background" Classes="Container">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" SharedSizeGroup="INPUT_labelcol" />
              <ColumnDefinition Width="*" MinWidth="80" />
              <ColumnDefinition Width="Auto" SharedSizeGroup="INPUT_unitcol"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="{TemplateBinding Label}" Classes="Label" Grid.Column="0" />
            <TextBox Name="PART_Input" Text="{TemplateBinding Value, Mode=TwoWay}" Grid.Column="1" Margin="10,0" />
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

</ResourceDictionary>
