<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:tc="clr-namespace:OpenTabletDriver.External.Avalonia.TemplatedControls"
                    mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="100">

  <ControlTheme x:Key="{x:Type tc:BooleanInput}" TargetType="tc:BooleanInput">
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_Background" Classes="Container">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" SharedSizeGroup="INPUT_labelcol" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Text="{TemplateBinding Label}" Classes="Label" Grid.Column="0" />
            <ToggleButton Name="PART_Toggle" IsChecked="{TemplateBinding Value, Mode=TwoWay}" 
                          IsEnabled="{TemplateBinding IsReadOnly, Converter={x:Static BoolConverters.Not}}" Grid.Column="2" Padding="10" />
          </Grid>
        </Border>
      </ControlTemplate>
    </Setter>
  </ControlTheme>

</ResourceDictionary>